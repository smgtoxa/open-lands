#death-slots {
  -unity-text-align: middle-left;
  margin-top: 12px;
}
#camp-sheet-close {
  border-color: #ffd66b;
}
#craft-note {
  margin: 8px 0 0;
}
.inventory-head #hand-icon {
  width: 40px;
  height: 40px;
}
#camp-sheet-close:hover {
  border-color: #ffd66b;
}
#rest-wake:hover {
  border-color: #ffd66b;
}
#inventory-drop-mode.on {
  border-color: #ffd66b;
  color: #ffd66b;
  background-color: #26210f;
}
.camp-travel #travel-note {
  margin: 6px 0 0;
  font-size: 12px;
  color: #8a8375;
}
#craft-note.ok {
  color: #9fd0a0;
}
#quest-list .tag-li.pinned {
