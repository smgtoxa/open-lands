}
.lantern.off #lantern-flame {
  opacity: 0;
}
.action-button.action-button.action-button.action-button {
  border-color: #cab66e;
  background-color: #2a2217;
}
.ibtn.ibtn.ibtn.ibtn {
  padding: 5px 6px;
}
.spell-cast.spell-cast.spell-cast.spell-cast {
